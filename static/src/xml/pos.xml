<!-- for keyboard shortcut help button and details -->
    <t t-extend="NumpadWidget">
		<t t-jquery=".numpad" t-operation="after">
			<span class="control-button" id="shortcut_tips_btn" style="width: 384px;margin-right: 5px;margin-top: -8px;">
				<i class='fa fa-info-circle' style="font-size:24px;"/> Shortcut Tips (F2)
			</span>
		</t>
	</t>

    <t t-name="ShortcutTipsWidget">
        <div role="dialog" class="modal-dialog modal-dialog-shortcut-tips">
            <div class="popup popup-shortcut-tips" style="width:40%;height: 70%;">
                <header class="title">Keyboard Shortcut - Tips</header>
                <div class="body" style="height:75%;overflow-y:scroll;">
                    <h3>Instructions (READ):</h3>
                    <div style="width:100%;text-align:left;">
                        <ul>
                            <li style="font-size:16px;color:red;">Pressing the corresponding letter will activate the command. For example, to set the quantity, press the 'C' key. When the focus is on the search field, commands will not work except for <b>"TAB"</b> o <b>"F2"</b>,  click anywhere outside the search field or press<b>"TAB"</b>to restore letter commands. Alternatively, to force commands to work even when the focus is on the search field  <b>CTRL</b> key followed by the command letter,fFor example, to set the quantity, press <b>Ctrl+D</b>.</li>
                            <li style="font-size:16px;color:red;">Press <b>"F2"</b> to show this help.</li>
                        </ul>
                    </div>
                    <h3>View of the products</h3>
                    <table class="shortcut-tips-table">
                        <tr width="50%">
                            <th>Keyboard Shortcut</th><th>Description</th>
                        </tr>
                        <tr><td width="25%">F2</td><td width="75%">Keyboard Shortcut - Tips</td></tr>
                        <tr><td>Ctrl+F</td><td>Search</td></tr>
                        <tr><td>Tab</td><td>Toggle between negative and positive the quantity of the selected product line.</td></tr>
                        <tr><td>C / Ctrl + C</td><td>Select the 'Quantity' button on the numeric keypad to change the quantity of the selected product line.</td></tr>
                        <tr><td>D / Ctrl + D</td><td>Select the 'Discount' button on the numeric keypad to change the discount of the selected product line.</td></tr>
                        <tr><td>P / Ctrl + P</td><td>Select the 'Price' button on the numeric keypad to change the price of the selected product line.</td></tr>
                        <tr><td>Backspace</td><td>removes the last selected number from 'Quantity', 'Discount', or 'Price'</td></tr>
                        <tr><td>0-9 (Numeric keypad)</td><td>Change the number for 'Quantity', 'Discount', or 'Price'</td></tr>
                        <tr><td>. (Numeric keypad)</td><td>Decimal point.</td></tr>
                        <tr><td>L / Ctrl + L</td><td>Open client list.</td></tr>
                        <tr><td>Space / Ctrl + Space</td><td>Go to Payment view.</td></tr>
                        <tr><td>Delete</td><td>Delete the selected order line..</td></tr>
                        <tr><td>Up</td><td>Move the order line up.</td></tr>
                        <tr><td>Down</td><td>Move the order line down.</td></tr>
                        <tr><td>Shift+(Up|Left)</td><td>Select the previous product in the product list.</td></tr>
                        <tr><td>Shift+(Down|Right)</td><td>Select the next product in the product list.</td></tr>
                    </table>

                    <h3 style="margin-top:40px;">Customer list</h3>
                    <table class="shortcut-tips-table">
                        <tr width="50%">
                            <th>Keyboard Shortcuts</th><th>Description</th>
                        </tr>
                        <tr><td width="25%">Esc</td><td width="75%">Cancel and go back</td></tr>
                        <tr><td>Ctrl+F</td><td>Search</td></tr>
                        <tr><td>Up</td><td>Select the previous customer above.</td></tr>
                        <tr><td>Down</td><td>Select the next customer below.</td></tr>
                        <tr><td>Enter</td><td>Select/Deselect customer.</td></tr>
                        <tr><td>+ (Plus sign)</td><td>Create customer</td></tr>
                    </table>

                    <h3 style="margin-top:40px;">Payment View</h3>
                    <table class="shortcut-tips-table">
                        <tr width="50%">
                            <th>Keyboard Shortcuts</th><th>Description</th>
                        </tr>
                        <tr><td width="25%">Esc</td><td width="75%">Cancel and go back</td></tr>
                        <tr><td>L / Ctrl + L</td><td>Open customer list.</td></tr>
                        <tr><td>I / Ctrl + I</td><td>Select/Deselect print invoice.</td></tr>
                        <tr><td>Page Up</td><td>Move payment method selection up.</td></tr>
                        <tr><td>Page Down</td><td>Move payment method selection down.</td></tr>
                        <tr><td>Space</td><td>Choose payment method.</td></tr>
                        <tr><td>Up Arrow</td><td>Move payment line up.</td></tr>
                        <tr><td>Down Arrow</td><td>Move payment line down.</td></tr>
                        <tr><td>Delete</td><td>Delete selected payment method.</td></tr>
                    </table>

                    <h3 style="margin-top:40px;">Receipt View"</h3>
                    <table class="shortcut-tips-table">
                        <tr width="50%">
                            <th>Keyboard Shortcuts</th><th>Description</th>
                        </tr>
                        <!--<tr><td width="25%">I</td><td width="75%">Imprimir factura de cliente</td></tr>-->
                        <tr><td>R</td><td>Print POS payment receipt</td></tr>
                        <tr><td>Enter</td><td>Accept/Validate</td></tr>
                    </table>

                    <h3 style="margin-top:40px;">Others</h3>
                    <table class="shortcut-tips-table">
                        <tr width="50%">
                            <th>Keyboard Shortcuts</th><th>Description</th>
                        </tr>
                        <tr><td width="25%">Esc</td><td width="75%">Close Current</td></tr>
                    </table>
                </div>                
                <footer class="footer">                        
                    <div class="button cancel">
                        Cancel                        
                    </div>
                </footer>                                                
            </div>           
       </div>
    </t>
</templates>
